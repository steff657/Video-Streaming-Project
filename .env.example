# Django Security Settings
DEBUG=True
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# CORS Settings (for API requests)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Database (optional - SQLite is default)
# DATABASE_URL=postgresql://user:password@localhost:5432/yourtubeflix
DB_SSL_REQUIRE=True

# File Upload Settings
MAX_UPLOAD_SIZE=209715200
ALLOWED_VIDEO_EXTENSIONS=mp4,mov,webm,mkv

# Production HTTPS settings (recommended on Heroku)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Email (for password resets, optional)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
