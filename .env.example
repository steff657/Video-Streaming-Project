# Django Security Settings
DEBUG=True
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS Settings (for API requests)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Database (optional - SQLite is default)
# DATABASE_URL=postgresql://user:password@localhost:5432/yourtubeflix

# File Upload Settings
MAX_UPLOAD_SIZE=209715200  # 200 MB in bytes
ALLOWED_VIDEO_EXTENSIONS=mp4,mov,webm,mkv

# Object storage for production media (required on Heroku)
USE_S3=False
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_STORAGE_BUCKET_NAME=your-bucket-name
# AWS_S3_REGION_NAME=us-east-1

# Email (MailerSend SMTP)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.mailersend.net
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_HOST_USER=your-mailersend-smtp-username
# EMAIL_HOST_PASSWORD=your-mailersend-smtp-password
# DEFAULT_FROM_EMAIL=no-reply@your-verified-domain.com
# SERVER_EMAIL=no-reply@your-verified-domain.com
# EMAIL_TIMEOUT=30
